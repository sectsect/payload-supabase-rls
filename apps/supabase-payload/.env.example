# Database Configuration
DATABASE_URI=postgresql://postgres.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# PayloadCMS Configuration
PAYLOAD_SECRET=your-secret-key-here

# Supabase Storage Configuration (S3 Compatible)
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=us-east-1
S3_ENDPOINT=https://[YOUR-PROJECT-ID].supabase.co/storage/v1/s3

# MCP Server Configuration
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp?project_ref=YOUR-PROJECT-REF
