{
  "name": "supabase-payload",
  "version": "1.0.1",
  "private": true,
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:types": "payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint ./",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint ./ --fix",
    "type-check": "tsc --noEmit --pretty",
    "type-check:watch": "npm run type-check -- --watch",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "rls:enable": "payload-supabase-rls enable",
    "rls:verify": "payload-supabase-rls verify",
    "rls:status": "payload-supabase-rls status"
  },
  "dependencies": {
    "@sect/payload-supabase-rls": "workspace:*",
    "@atelier-disko/payload-lexical-react-renderer": "^1.0.4",
    "@payloadcms/db-postgres": "^3.69.0",
    "@payloadcms/next": "^3.69.0",
    "@payloadcms/plugin-cloud": "^3.0.2",
    "@payloadcms/richtext-lexical": "^3.69.0",
    "@payloadcms/storage-s3": "^3.69.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.11",
    "graphql": "^16.8.1",
    "is-url": "^1.2.4",
    "next": "^15.5.9",
    "payload": "^3.69.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "0.34.5",
    "swiper": "^11.1.5",
    "tailwind-merge": "^2.4.0",
    "ts-pattern": "^5.2.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^1.49.0",
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@next/eslint-plugin-next": "^15.3.9",
    "@tanstack/eslint-plugin-query": "^5.51.1",
    "@types/is-url": "^1.2.32",
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/eslint-plugin": "^1.3.25",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "^15.3.9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.5.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
