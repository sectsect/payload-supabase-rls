{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "${SUPABASE_MCP_URL}"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "/Users/sect/workspace/supabase-payload"
      ]
    }
  }
}
