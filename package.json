{
  "name": "payload-supabase-rls-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build --log-order=grouped",
    "dev": "turbo dev --cache=local:,remote: --continue",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "coverage": "turbo coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "type-check:watch": "turbo type-check:watch",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=@sect/payload-supabase-rls && changeset publish",
    "secretlint": "secretlint --maskSecrets --secretlintignore .gitignore '**/*'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint-react/eslint-plugin": "^2.4.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/eslint-plugin": "^1.6.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^7.15.3",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "secretlint": "^11.2.5",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": ">=10.0.0"
  }
}
